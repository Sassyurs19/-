{
  "name": "jagent-telegram-bot",
  "version": "1.0.0",
  "description": "Telegram bot for minting $JAGENT on jager.live via Binance Agentic Wallet",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "nodemon --exec ts-node src/index.ts",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@binance/agentic-wallet": "^1.12.0",
    "axios": "^1.7.7",
    "axios-retry": "^4.5.0",
    "better-sqlite3": "^13.2.0",
    "bottleneck": "^2.19.5",
    "csv-stringify": "^6.5.1",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "grammy": "^1.31.0",
    "grammy-inline-menu": "^9.1.0",
    "node-cron": "^3.0.3",
    "node-forge": "^1.3.1",
    "qrcode": "^1.5.4",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.9.0",
    "@types/node-forge": "^1.3.11",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
